# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# Required for the AI chatbot. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port the backend runs on locally (Vercel/Render will set their own)
PORT=5000

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://anuppudasaini.com.np
